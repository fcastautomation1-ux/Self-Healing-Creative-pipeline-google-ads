# Creative Pipeline API Environment Configuration

# Server Settings
PORT=8000
HOST=0.0.0.0
DEBUG=false
ENVIRONMENT=development

# Storage Settings
STORAGE_BACKEND=local  # Options: 'local', 'drive'
LOCAL_STORAGE_DIR=./processed_assets
BASE_URL=http://localhost:8000

# Google Cloud / Google Drive Integration (Optional for local testing)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# YouTube Data API v3 (Optional: fallback to oEmbed probe if empty)
YOUTUBE_API_KEY=
